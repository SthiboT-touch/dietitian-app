# Copy this file to .env and fill in the values. .env is ignored by Git; never commit it.

# Database password for the "black" user (used by docker compose).
DB_PASSWORD=change-me

# Optional: model used by Ollama.
# OLLAMA_MODEL=llama3.2

# --- LangSmith tracing (optional) ---
# Get a key at https://smith.langchain.com  ->  Settings  ->  API Keys.
# Docker: start with  docker compose -f docker-compose.yml -f docker-compose.langsmith.yml up --build -d
# GitHub deploy: add the key as the repository secret LANGSMITH_API_KEY (the workflow passes it to the server).
# Traces can contain chat messages and health details: use synthetic data only.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dietitian-app
# EU workspace? Use https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Only for running the API outside Docker ---
APP_USE_IN_MEMORY_DB=1
# DATABASE_URL=postgresql://black:password@localhost:5432/dietitian_db
# OLLAMA_BASE_URL=http://localhost:11434
