# Copy to .env on your own computer. Put secrets only in .env; never commit them.
DB_PASSWORD=REPLACE_WITH_YOUR_EXISTING_LOCAL_DATABASE_PASSWORD
# Optional LangSmith tracing. Add your key below, then enable tracing.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=dietitian-app
# Paste your LangSmith API key here in .env only. Do not share or commit it.
LANGSMITH_API_KEY=

# FR-1.3: optional trusted proxy address/CIDR for X-Real-IP.
# Leave blank until your local reverse proxy IP has been verified.
# Never set 0.0.0.0/0; an untrusted client could spoof the recorded IP.
REGISTRATION_TRUSTED_PROXY_CIDRS=

# Optional FR-1.5 onboarding email. Do not enable the notifications profile
# until your clinic approves the email and you supply valid SMTP credentials.
WELCOME_SMTP_HOST=
WELCOME_SMTP_PORT=587
WELCOME_SMTP_USER=
WELCOME_SMTP_PASSWORD=
WELCOME_FROM_EMAIL=
